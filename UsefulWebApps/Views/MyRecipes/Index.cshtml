@using UsefulWebApps.Models.MyRecipes
@{
    ViewData["Title"] = "My Recipes";
}

@model UsefulWebApps.Models.ViewModels.MyRecipes.RecipeIndexVM

<div class="text-center max-width-550 mx-auto container pb-3">
    <h1 class="display-3 mt-3">Recipes</h1>
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <p>To make a new recipe click <a asp-controller="MyRecipes" asp-action="CreateRecipe">here</a></p>
        <p>To view your saved recipes click <a asp-controller="MyRecipes" asp-action="SavedRecipes">here</a></p>
    }
    
    <h4>Search: Title and Ingredients</h4>
    <form asp-controller="MyRecipes" asp-action="Index" id="search-form">
        <div class="input-group mb-3">  
            <input type="text" class="form-control" id="search-input" name="SearchString" asp-for="@Model.SearchString" />
            <input class="btn btn-outline-dark" type="submit" value="Search" />
            <input class="btn btn-outline-secondary" type="button" value="Clear" onclick="clearSearch()" />
        </div>
        <input type="hidden" asp-for="@Model.Ascending" />
    </form>
    <h4>Filter: Tags</h4>
    <form asp-controller="MyRecipes" asp-action="Index" id="filter-tags-form">
        <ul class="list-group mt-3 choice-list">
            @for (int i = 0; i < Model.RecipeCategories.Count; i++)
            {
                <li class="list-group-item list-group-item-action active">
                    <input class="form-check-input me-1 tags-ck-box" type="checkbox" asp-for="@Model.RecipeCategories[i].IsChecked" />
                    <label class="form-check-label stretched-link" asp-for="@Model.RecipeCategories[i].IsChecked">@Model.RecipeCategories[i].Category</label>
                    <input type="hidden" asp-for="@Model.RecipeCategories[i].CategoryId" />
                    <input type="hidden" asp-for="@Model.RecipeCategories[i].Category" />
                </li>
            }
        </ul>
        <input class="btn btn-outline-dark mb-3" type="submit" value="Filter" />
        <input class="btn btn-outline-secondary mb-3" type="button" value="Clear" onclick="clearSearch()" />
        <input type="hidden" asp-for="@Model.Ascending" />
    </form>
    <h4>Recipes</h4>
    <a class="btn @(Model.Ascending ? "btn-outline-dark" : "btn-outline-secondary") mb-2"
        asp-controller="MyRecipes" 
        asp-action="Index" 
        asp-route-ascending="true" 
        asp-route-categories="@Model.CategoriesQuery" 
        asp-route-searchString="@Model.SearchString" 
        asp-route-page="@(Model.CurrentPage)">
        Ascending
    </a>
    <a class="btn @(!Model.Ascending ? "btn-outline-dark" : "btn-outline-secondary") mb-2"
        asp-controller="MyRecipes" 
        asp-action="Index" 
        asp-route-ascending="false" 
        asp-route-categories="@Model.CategoriesQuery" 
        asp-route-searchString="@Model.SearchString" 
        asp-route-page="@(Model.CurrentPage)">
        Descending
    </a>
    <div class="list-group">
        @foreach (Recipe recipe in Model.Recipes)
        {
            <div class="card mb-3">
                <h4 class="card-title">
                    <a class="list-group-item list-group-item-action" 
                        asp-controller="MyRecipes" 
                        asp-action="Recipe" 
                        asp-route-id="@recipe.RecipeId"
                        asp-route-page="@Model.CurrentPage"
                        asp-route-searchString="@Model.SearchString"
                        asp-route-categories="@Model.CategoriesQuery"
                        asp-route-ascending="@Model.Ascending">
                            @recipe.RecipeTitle
                    </a>
                </h4>
                <div class="card-body">
                    @if (!String.IsNullOrEmpty(recipe.RecipeDescription))
                    {
                        <p class="card-text">@recipe.RecipeDescription</p>
                    }
                    <p class="card-text">Author: @recipe.UserName</p>
                    <p class="card-text">Rating: @recipe.Rating</p>
                    
                </div>
                @if (String.IsNullOrEmpty(recipe.ImagePath))
                {
                    <img src="~/images/recipes/dish-spoon-knife-icon.png" class="img-fluid max-width-250 mx-auto" />
                }
                else
                {
                    <img src="@recipe.ImagePath" class="img-fluid max-width-250 mx-auto" />
                }
            </div>            
        }
    </div>
    <div class="mt-4">
        <total-recipes total-recipes="@Model.TotalRecipes"></total-recipes>
    </div>
    <div class="mt-4 max-width-300 mx-auto">
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm justify-content-center">
                @if(Model.TotalPages < 4)
                {
                    <li class="page-item"><a class="page-link" asp-controller="MyRecipes" asp-action="Index" asp-route-ascending="@Model.Ascending" asp-route-categories="@Model.CategoriesQuery" asp-route-searchString="@Model.SearchString" asp-route-page="@(Model.CurrentPage - 1 == 0 ? 1 : Model.CurrentPage - 1)">Previous</a></li>
                    <li class="page-item"><a class="page-link" asp-controller="MyRecipes" asp-action="Index" asp-route-ascending="@Model.Ascending" asp-route-categories="@Model.CategoriesQuery" asp-route-searchString="@Model.SearchString" asp-route-page="@(Model.CurrentPage + 1 < Model.TotalPages ? Model.CurrentPage + 1 : Model.TotalPages)">Next</a></li>
                }
                else if(Model.TotalPages >= 4 && Model.TotalPages < 8)
                {
                    <!--display 1st and last pages if more than 4 pages total-->
                    <li class="page-item"><a class="page-link" asp-controller="MyRecipes" asp-action="Index" asp-route-ascending="@Model.Ascending" asp-route-categories="@Model.CategoriesQuery" asp-route-searchString="@Model.SearchString" asp-route-page="@(Model.CurrentPage - 1 == 0 ? 1 : Model.CurrentPage - 1)">&laquo;</a></li>
                    @for (int i = 1; i <= @Model.TotalPages; i++)
                    {
                        if (i == 1)
                        {
                            <li class="page-item"><a class="page-link" asp-controller="MyRecipes" asp-action="Index" asp-route-ascending="@Model.Ascending" asp-route-categories="@Model.CategoriesQuery" asp-route-searchString="@Model.SearchString" asp-route-page="@i">@i</a></li>
                        }
                        else if (i == 2)
                        {
                            <li class="page-item disabled"><a class="page-link">...</a></li>
                        }
                        else if (i == Model.TotalPages)
                        {
                            <li class="page-item"><a class="page-link" asp-controller="MyRecipes" asp-action="Index" asp-route-ascending="@Model.Ascending" asp-route-categories="@Model.CategoriesQuery" asp-route-searchString="@Model.SearchString" asp-route-page="@i">@i</a></li>
                        }
                    }
                    <li class="page-item"><a class="page-link" asp-controller="MyRecipes" asp-action="Index" asp-route-ascending="@Model.Ascending" asp-route-categories="@Model.CategoriesQuery" asp-route-searchString="@Model.SearchString" asp-route-page="@(Model.CurrentPage + 1 < Model.TotalPages ? Model.CurrentPage + 1 : Model.TotalPages)">&raquo;</a></li>
                }
                else if(Model.TotalPages >= 8)
                {
                    <!--display 1st 3 and last 3 pages if more than 8 pages total-->
                    <li class="page-item"><a class="page-link" asp-controller="MyRecipes" asp-action="Index" asp-route-ascending="@Model.Ascending" asp-route-categories="@Model.CategoriesQuery" asp-route-searchString="@Model.SearchString" asp-route-page="@(Model.CurrentPage - 1 == 0 ? 1 : Model.CurrentPage - 1)">&laquo;</a></li>
                    @for (int i = 1; i <= @Model.TotalPages; i++)
                    {
                        if (i <= 3)
                        {
                            <li class="page-item"><a class="page-link" asp-controller="MyRecipes" asp-action="Index" asp-route-ascending="@Model.Ascending" asp-route-categories="@Model.CategoriesQuery" asp-route-searchString="@Model.SearchString" asp-route-page="@i">@i</a></li>
                        }
                        else if (i == 4)
                        {
                            <li class="page-item disabled"><a class="page-link">...</a></li>
                        }
                        else if (i > Model.TotalPages - 3)
                        {
                            <li class="page-item"><a class="page-link" asp-controller="MyRecipes" asp-action="Index" asp-route-ascending="@Model.Ascending" asp-route-categories="@Model.CategoriesQuery" asp-route-searchString="@Model.SearchString" asp-route-page="@i">@i</a></li>
                        }
                    }
                    <li class="page-item"><a class="page-link" asp-controller="MyRecipes" asp-action="Index" asp-route-ascending="@Model.Ascending" asp-route-categories="@Model.CategoriesQuery" asp-route-searchString="@Model.SearchString" asp-route-page="@(Model.CurrentPage + 1 < Model.TotalPages ? Model.CurrentPage + 1 : Model.TotalPages)">&raquo;</a></li>
                }
            </ul>
        </nav>
    </div>
</div>

<!--scripts-->
@section Scripts {
    <script type="text/javascript">
        function clearSearch() {
            $("#search-input").val("");
            $("#search-form").submit();
        }
    </script>
}


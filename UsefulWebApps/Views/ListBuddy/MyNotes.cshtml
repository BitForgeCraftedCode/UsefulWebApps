@{
    ViewData["Title"] = "My Notes";
}

@model UsefulWebApps.Models.ViewModels.ListBuddy.NotesVM

<div class="text-center container pb-3">
    <h1 class="display-3 mt-3">My Notes</h1>
    <div class="list-group max-width-350 mx-auto">
        @foreach (var note in Model.MyNotes)
        {
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <a asp-controller="ListBuddy" asp-action="Note" asp-route-id="@note.Id"
                       class="text-decoration-none flex-grow-1">
                    @note.NoteTitle
                </a>
                @if (Model.SharedToFriends.ContainsKey(note.Id))
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-pill"
                              title="Shared with: @string.Join(", ", Model.SharedToFriends[note.Id])">
                            Shared
                        </span>
                        <form method="post" asp-action="UnshareNote" class="unshare-note">
                            <input type="hidden" name="noteId" value="@note.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Unshare</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
    @if (Model.SharedWithMeNotes.Any())
    {
        <h1 class="display-3 mt-3">Shared With Me</h1>
        <div class="list-group max-width-350 mx-auto">
            @foreach (var note in Model.SharedWithMeNotes)
            {
                <a asp-controller="ListBuddy" asp-action="Note" asp-route-id="@note.Id"
                       class="list-group-item list-group-item-action">
                    @note.NoteTitle
                </a>
            }
        </div>
    }
    <div class="max-width-250 mx-auto mt-3">
        <div class="mb-3">
            <a asp-controller="ListBuddy" asp-action="CreateNote" class="btn w-100">Add New Note</a>
        </div>
        <div>
            <a asp-controller="ListBuddy" asp-action="Index" class="btn btn-outline-dark w-100">List Buddy Home</a>
        </div>
    </div>
</div>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
    <script type="text/javascript">
        $(".unshare-note").each(function () {
            $(this).validate({
                submitHandler: function (form) {
                    //ask to confirm unshare
                    toastConfirmUnshareNote().then(unshareConfirm => {
                        if (unshareConfirm == true) {
                            form.submit();
                        } else {
                            toastr.success("Note has NOT been unshared");
                        }
                    });
                }
            });
        });
    </script>
}
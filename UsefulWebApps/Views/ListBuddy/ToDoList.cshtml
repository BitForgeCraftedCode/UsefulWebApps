@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "To Do List";
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
@* https://stackoverflow.com/questions/65378476/how-to-refresh-data-without-page-reloading-in-asp-net-core-mvc-using-ajax *@
@model UsefulWebApps.Models.ViewModels.ListBuddy.ToDoListVM

<div class="text-center max-width-550 mx-auto container pb-3">
    <input id="RequestVerificationToken" type="hidden" value="@requestToken" />
    <h1 class="display-3 mt-3">@Model.ToDoList.ListTitle</h1>
    <div id="to-do-list-container">
        <partial name="_ToDoListPartial" />
    </div>
    <div id="spinner-container" class="mt-3">
        <div id="spinner" class="loader">
            Loading...
        </div>
    </div>
   
    <form method="post" class="max-width-550" id="add-to-do-item">
        <div class="input-group mb-3 mt-3">
            <!--Complete default value is False-->
            <input asp-for="ToDoItem.ListVersion" value="@Model.ToDoList.Version" type="hidden" id="version-add-form" />
            <input asp-for="ToDoItem.ListId" type="hidden" />
            <input asp-for="ToDoItem.Complete" type="hidden" />
            <input asp-for="ToDoItem.SortOrder" type="hidden" />
            <input asp-for="ToDoItem.ToDoItem" type="text" class="form-control" placeholder="New Item" minlength="3" maxlength="100" />
            <button class="btn btn-outline-dark" type="submit">Add Item</button>
        </div>
        <div class="mb-3" id="new-to-do-error"></div>
    </form>
    <form method="post" asp-route="deleteAllToDoList" class="max-width-175 mx-auto" id="delete-all-to-do">
        <input asp-for="ToDoList.Id" hidden />
        <input asp-for="ToDoList.UserId" hidden />
        <input asp-for="ToDoList.ListTitle" hidden />
        <input asp-for="ToDoList.Version" hidden />
      
        <div>
            <button type="submit" class="btn btn-danger mb-3 w-100">Delete All</button>
        </div>
        <div>
            <a asp-controller="ListBuddy" asp-action="MyToDoLists" class="btn btn-outline-dark mb-3 w-100">Back To My Lists</a>
        </div>
    </form>
    @if (Model.ToDoList.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
    {
        <div class="max-width-175 mx-auto row">
            <div class="col-12 ps-0 pe-0">
                <a asp-controller="ListBuddy" asp-action="ShareToDoList" asp-route-id="@Model.ToDoList.Id" class="btn btn-outline-dark mb-3 w-100">
                    Share List
                </a>
            </div>
        </div>
    }
</div>
<!--Partial View scripts-->
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
    <!--Ajax and validation-->
    <script type="text/javascript" src="~/js/ToDoList.js"></script>
}
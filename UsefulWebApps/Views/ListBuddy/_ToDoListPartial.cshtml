
<input type="hidden" value="@Model.ToDoList.Version" id="version-in-partial" />
<ul class="list-group">
    @foreach (var obj in Model.ToDoListItems)
    {
        <li class="list-group-item list-group-item-action active" id="to-do-li-@obj.Id">
            <span class="fw-bold to-do-list-item @(obj.Complete == true ? "line-through" : "")">@obj.ToDoItem</span>
            <div>
                <div class="to-do-list-mark-complete">
                    <button type="button" class="btn btn-dark btn-sm" onclick="toggleComplete(@obj.Id, @obj.ListId, @Model.ToDoList.Version)">Complete</button>
                </div>

                <div class="to-do-list-edit">
                    <a asp-controller="ListBuddy" asp-action="ToDoListEdit" asp-route-id="@obj.Id" class="btn btn-dark btn-sm">Edit</a>
                </div>
                <div class="to-do-list-delete-item">
                    <button type="submit" class="btn  btn-sm @(obj.Complete == true ? "btn-outline-danger" : "btn-danger")" onclick="validateDeleteToDo(@obj.Id, @obj.ListId, @Model.ToDoList.Version)">Delete</button>
                </div>
                <div class="to-do-list-sort-item">
                    <select class="form-select form-select-sm mt-2" onchange="sortToDoItem(@obj.Id, @obj.ListId, this.value, @Model.ToDoList.Version)">
                        @for (int i = 0; i < Model.ToDoListItems.Count; i++)
                        {
                            <option value="@i" selected="@(i == obj.SortOrder)">@(i+1)</option>
                        }
                    </select>
                </div>
            </div>
        </li>
    }
</ul>
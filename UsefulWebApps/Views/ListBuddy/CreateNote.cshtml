@{
    ViewData["Title"] = "Create Note";
}
@model UsefulWebApps.Models.ListBuddy.Notes

<div class="max-width-550 mx-auto container pb-3">
    <h1 class="display-3 mt-3 text-center">Create Note</h1>
    <form method="post" id="note-form">
        <input type="hidden" asp-for="UserId" />
        <h3 class="mt-3 text-center">Title</h3>
        <div class="form-floating mb-3">
            <input asp-for="NoteTitle" type="text" class="form-control" placeholder="Note Title" minlength="3" maxlength="100" required />
            <label asp-for="NoteTitle">Note Title</label>
            <span asp-validation-for="NoteTitle" class="text-danger"></span>
        </div>
        <h3 class="mt-3 text-center">Note</h3>
        <div class="form-floating">
            <div id="editor" class="form-control textarea-input"></div>
            <textarea asp-for="Note" class="form-control textarea-input d-none" minlength="10" maxlength="5000" required placeholder="Note"></textarea>
            <label asp-for="Note" class="d-none">Note</label>
            <span asp-validation-for="Note" class="text-danger"></span>
            <span class="character-count"></span>
        </div>

        <div class="max-width-200 mx-auto">
            <div>
                <button class="btn btn-primary mb-3 mt-3 w-100" type="submit">Create Note</button>
            </div>
            <div>
                <a asp-controller="ListBuddy" asp-action="MyNotes" class="btn btn-outline-dark w-100">Back To My Notes</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
        <script type="text/javascript" src="~/js/Notes.js"></script>
    }
}
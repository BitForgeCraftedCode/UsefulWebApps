@{
    ViewData["Title"] = "Share Event";
}
@model UsefulWebApps.Models.ViewModels.Calendar.ShareEventVM

<div class="max-width-550 mx-auto container pb-3">
    <h1 class="display-3 mt-3 text-center">Share Event</h1>

    @if (!Model.FriendsList.Any())
    {
        <p class="text-center">You have no friends to share with yet.</p>
    }
    else
    {
        <form method="post">
            <input type="hidden" asp-for="EventId" />
            <div class="form-floating mb-3">
                <select asp-for="SelectedFriendUserId" asp-items="Model.FriendsList"
                        class="form-select" required>
                    <option value="">-- Select a Friend --</option>
                </select>
                <label asp-for="SelectedFriendUserId">Share With</label>
                <span asp-validation-for="SelectedFriendUserId" class="text-danger"></span>
            </div>
            <div class="max-width-200 mx-auto">
                <button class="btn btn-primary w-100 mb-3" type="submit">Share Event</button>
                <a asp-action="EditEvent" asp-route-id="@Model.EventId"
                   class="btn btn-outline-dark w-100">Back To Event Edit</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@using UsefulWebApps.Models.ViewModels.Calendar
@{
    ViewData["Title"] = "Edit Event";
}

@model UsefulWebApps.Models.ViewModels.Calendar.CalendarEventsVM

<div class="max-width-550 mx-auto container pb-3">
    <h1 class="display-3 mt-3 text-center">Edit Event</h1>
    <form method="post" id="editEventForm">
        <input type="hidden" asp-for="Event.UserId" />
        <input type="hidden" asp-for="Event.Id" />
        <h3 class="mt-3 text-center">Title</h3>
        <div class="form-floating mb-3">
            <input asp-for="Event.Title" type="text" class="form-control" placeholder="Event Title" minlength="3" maxlength="255" required />
            <label asp-for="Event.Title">Event Title</label>
            <span asp-validation-for="Event.Title" class="text-danger"></span>
        </div>
        <p>
            The below note input allow basic HTML.
            Click <a asp-action="Directions" asp-controller="Home" target="_blank">here</a> for more detail.
        </p>

        <h3 class="mt-3 text-center">Description</h3>
        <div class="form-floating">
            <textarea asp-for="Event.Description" class="form-control textarea-input ignore" placeholder="Description"></textarea>
            <label asp-for="Event.Description">Description</label>
        </div>

        <h3 class="mt-3 text-center">Start Date</h3>
        <div class="form-floating mb-3">
            <input asp-for="Event.StartDate" type="date" class="form-control" required />
            <label asp-for="Event.StartDate">Start Date</label>
            <span asp-validation-for="Event.StartDate" class="text-danger"></span>
        </div>

        <h3 class="mt-3 text-center">End Date</h3>
        <div class="form-floating mb-3">
            <input asp-for="Event.EndDate" type="date" class="form-control" required />
            <label asp-for="Event.EndDate">End Date</label>
            <span asp-validation-for="Event.EndDate" class="text-danger"></span>
        </div>

        <h3 class="mt-3 text-center">Event Duration</h3>
        <div class="max-width-150 form-check mb-3 mx-auto">
            <input asp-for="Event.IsAllDay" class="form-check-input" type="checkbox">
            <label asp-for="Event.IsAllDay" class="form-check-label">All Day Event</label>
        </div>

        <h3 class="mt-3 text-center">Event Privacy</h3>
        <div class="max-width-150 form-check mb-3 mx-auto">
            <input asp-for="Event.IsPrivate" class="form-check-input" type="checkbox">
            <label asp-for="Event.IsPrivate" class="form-check-label">Private Event</label>
        </div>

        <h3 class="mt-3 text-center">Event Recurrence</h3>
        <div class="max-width-150 form-check mb-3 mx-auto">
            <input asp-for="IsRecurring" class="form-check-input" type="checkbox">
            <label asp-for="IsRecurring" class="form-check-label">Repeat Event</label>
        </div>

        <div id="recurrenceOptions" style="display: none;">

            <label asp-for="Frequency">Repeating Frequency</label>
            <select asp-for="Frequency" class="form-select mb-3">
                <option value="Daily">Daily</option>
                <option value="Weekly">Weekly</option>
                <option value="Monthly">Monthly</option>
                <option value="Yearly">Yearly</option>
            </select>



            <div class="form-floating mb-3">
                <input asp-for="Interval" type="number" min="1" class="form-control" />
                <label asp-for="Interval" class="form-check-label">Every <span id="intervalUnit">1</span> <span id="frequencyUnit">week</span><span id="frequencyUnitPlural" style="display: none;">s</span></label>
            </div>

            <!-- Weekly options -->
            <div id="daysOfWeekContainer">
                <label asp-for="DaysOfWeek">Repeat On This Day Of The Week</label>
                <select asp-for="DaysOfWeek" class="form-select">
                    <option value="">Select</option>
                    <option value="Monday">Monday</option>
                    <option value="Tuesday">Tuesday</option>
                    <option value="Wednesday">Wednesday</option>
                    <option value="Thursday">Thursday</option>
                    <option value="Friday">Friday</option>
                    <option value="Saturday">Saturday</option>
                    <option value="Sunday">Sunday</option>
                </select>
            </div>

            <div class="form-floating mb-3 mt-3">
                <input asp-for="RecurrenceEndDate" type="date" class="form-control" />
                <label asp-for="RecurrenceEndDate">End on</label>
            </div>
        </div>


        <div class="max-width-200 mx-auto">
            @if (Model.SharedWithFriends.Any())
            {
                <div class="mb-3 text-start">
                    <h5 class="text-center">Shared With Friends</h5>
                    <ul class="list-group">
                        @foreach (string friendName in Model.SharedWithFriends)
                        {
                            <li class="list-group-item">@friendName</li>
                        }
                    </ul>
                </div>
            }
            <div>
                <button class="btn btn-primary mb-3 mt-3 w-100" type="submit">Edit Event</button>
            </div>
            <div>
                <a asp-controller="Calendar" asp-action="ShareEvent" asp-route-id="@Model.Event.Id" class="btn btn-outline-dark w-100 mb-3">Share Event</a>
            </div>
            <div>
                <a asp-controller="Calendar" asp-action="Index" class="btn btn-outline-dark w-100">Back To Calendar</a>
            </div>
        </div>
    </form>
    <div class="max-width-200 mx-auto">
        <div>
            <form method="post" asp-controller="Calendar" asp-action="UnshareEvent" id="unshare-event">
                <input type="hidden" name="eventId" value="@Model.Event.Id" />
                <button type="submit" class="btn btn-danger w-100 mt-3">Unshare Event</button>
            </form>
        </div>
    </div>
    <form method="post" asp-action="DeleteEvent" id="delete-event">
        <div class="max-width-200 mx-auto">
            <input type="hidden" name="id" asp-for="Event.Id" />
            <input type="hidden" name="userID" asp-for="Event.UserId" />
            <button type="submit" class="btn btn-danger mb-3 mt-3 w-100">Delete Event</button>
        </div>
    </form>

</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
    <script type="text/javascript">
        (function () {
            /*
            show recurring on load. element will show checked/unchecked from server
            */
            window.addEventListener('DOMContentLoaded', (event) => {

                if($('input[name="IsRecurring"]')[0].checked == true) {
                    $("#recurrenceOptions")[0].style.display = "block";
                }
                else {
                    $("#recurrenceOptions")[0].style.display = "none";
                }
            });
        })();
        $("#unshare-event").validate({
            submitHandler: function (form) {
                //ask to confirm unshare
                toastConfirmUnshareEvent().then(unshareConfirm => {
                    if (unshareConfirm == true) {
                        form.submit();
                    }
                    else {
                        toastr.success("Event has NOT been unshared");
                    }
                });
            }
        });
        $("#delete-event").validate({
            submitHandler: function (form) {
                //ask to confirm delete
                toastConfirm().then(deleteConfirm => {
                    if (deleteConfirm == true) {
                        form.submit();
                    }
                    else {
                        toastr.success("Event has NOT been deleted");
                    }
                });
            }
        });

        $("#editEventForm").validate({
            ignore: ".ignore"
        });
        $('input[name="IsRecurring"]').change(function() {
            if($('input[name="IsRecurring"]')[0].checked == true) {
                $("#recurrenceOptions")[0].style.display = "block";
            }
            else {
                $("#recurrenceOptions")[0].style.display = "none";
            }
        });
        $('input[name="Interval"]').change(function() {
            const interval = $(this).val();
            $("#intervalUnit").text(interval);

            if(interval == 1) {
                $("#frequencyUnitPlural")[0].style.display = "none";
            }
            else {
                $("#frequencyUnitPlural")[0].style.display = "inline";
            }

        });
        $('select[name="Frequency"]').change(function () {
            const freq = $(this).val();
            let unit = "day";

            if (freq === "Weekly")
                unit = "week";
            else if (freq === "Monthly")
                unit = "month";
            else if (freq === "Yearly")
                unit = "year";

            if (freq === "Weekly")
                $("#daysOfWeekContainer")[0].style.display = "block";
            else
                 $("#daysOfWeekContainer")[0].style.display = "none";

            $("#frequencyUnit").text(unit);
        });

    </script>
}
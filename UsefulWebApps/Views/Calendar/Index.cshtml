@using UsefulWebApps.Models.ViewModels.Calendar
@{
    ViewData["Title"] = "Calendar";
}

@model UsefulWebApps.Models.ViewModels.Calendar.CalendarMonthVM

@{
    DateTime prevMonth = new DateTime(Model.Year, Model.Month, 1).AddMonths(-1);
    DateTime nextMonth = new DateTime(Model.Year, Model.Month, 1).AddMonths(1);
}

<h2 class="mt-3 text-center">
    <a href="@Url.Action("Index", new { year = prevMonth.Year, month = prevMonth.Month })">◀</a>
    @Model.Year - @Model.Month
    <a href="@Url.Action("Index", new { year = nextMonth.Year, month = nextMonth.Month })">▶</a>
</h2>

<div class="ps-1 pe-1 calendar-desktop calendar-grid-desktop">
    <!-- Day-of-week header -->
    <div class="dow-header">Sun</div>
    <div class="dow-header">Mon</div>
    <div class="dow-header">Tue</div>
    <div class="dow-header">Wed</div>
    <div class="dow-header">Thu</div>
    <div class="dow-header">Fri</div>
    <div class="dow-header">Sat</div>

    @foreach (CalendarDayVM day in Model.Days)
    {
        string css = "day-box";
        if (!day.IsCurrentMonth) css += " other-month";
        if (day.IsToday) css += " today";

        <div class="@css">
            <div>@day.Date.Day</div>
            @foreach (var ev in day.Events)
            {
                <div class="calendar-event">
                    <a asp-controller="Calendar" asp-action="EditEvent" asp-route-id="@ev.Id">@ev.Title</a>
                </div>
            }
        </div>
    }
    
</div>

<div class="ps-1 pe-1 calendar-mobile calendar-grid-mobile text-center">
    @foreach (CalendarDayVM day in Model.Days)
    {
        string css = "day-box";
        if (!day.IsCurrentMonth) css += " other-month";
        if (day.IsToday) css += " today";

        <div class="@css agenda-day">
            <strong>@day.Date.ToString("dddd")</strong><br/>
            <strong>@day.Date.ToString("MMMM d")</strong>
            @foreach (var ev in day.Events)
            {
                <div>
                    <a asp-controller="Calendar" asp-action="EditEvent" asp-route-id="@ev.Id">
                        @ev.Title
                    </a>
                </div>
            }
        </div>
    }
</div>

<div class="max-width-250 mx-auto mt-3 pb-3">
    <div>
        <a asp-controller="Calendar" asp-action="CreateEvent" class="btn w-100">Add New Event</a>
    </div>
</div>

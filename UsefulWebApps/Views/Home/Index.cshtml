@{
    ViewData["Title"] = "Home Page";
}

<div class="container pb-3">
    <h1 class="text-center display-3 mt-3">Useful Web Apps</h1>
    <h2 class="text-center">Home Of The Dot Net Wizard</h2>
    <div class="mb-4 text-center">
        <img src="~/images/app/wizard3.gif" />
    </div>
    <p class="max-width-550 mx-auto">
        Hi, and welcome to our family sharing application.
        This is a private space where you'll find useful tools like lists, recipes, weather, a shared family calendar,
        and a customizable home page.
        <br /><br />
        All lists are private to your login. Recipes and recipe comments are shared with everyone,
        but you can only edit or delete recipes that you create. You are welcome to comment on any recipe.
        <br /><br />
        Future plans include adding a message board and possibly a website aggregator.
        Accounts are invitation-only and must be set up by an administrator.
        This application is intended for private family use only.
    </p>
    <div class="max-width-550 mx-auto">
        <p><strong>Features:</strong></p>
        <ul>
            <li>To-do list</li>
            <li>Notes</li>
            <li>
                Grocery lists
                <ul>
                    <li>Save a list template</li>
                    <li>Share lists with other users</li>
                </ul>
            </li>
            <li>
                Recipes
                <ul>
                    <li>Create, edit, and delete your own recipes</li>
                    <li>Upload a recipe image</li>
                    <li>Comment on any recipe</li>
                </ul>
            </li>
            <li>
                Calendar
                <ul>
                    <li>All U.S. federal holidays displayed automatically</li>
                    <li>Create one-time or recurring events</li>
                    <li>Mark events as private or shared</li>
                </ul>
            </li>
            <li>Weather</li>
            <li>
                Customizable home page
                <ul>
                    <li>Choose a set of quick links</li>
                    <li>Display favorite quotes</li>
                    <li>Customize the background slideshow</li>
                </ul>
            </li>
        </ul>
    </div>
</div>

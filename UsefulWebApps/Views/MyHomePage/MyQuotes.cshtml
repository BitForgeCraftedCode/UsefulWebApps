﻿@{
ViewData["Title"] = "My Quotes";
}

@model UsefulWebApps.Models.ViewModels.MyHomePage.QuotesVM

<div class="text-center container pb-3">
    <h1 class="display-3 mt-3">My Quotes</h1>

    @if (Model.MyQuotes.Any())
    {
        <div class="list-group mx-auto mt-4" style="max-width: 750px;">
            @foreach (var quote in Model.MyQuotes)
            {
                <div class="list-group-item">
                    <div class="row align-items-center gy-3">
                        <div class="col-lg-8 text-start">
                            <notes html-notes-content="@quote.Quote" class="mb-1" style="white-space: pre-line"></notes>
                            @if (!string.IsNullOrWhiteSpace(quote.Author))
                            {
                                <div class="text-muted">— @quote.Author</div>
                            }
                        </div>
                        <div class="col-lg-4">
                            <div class="d-flex justify-content-lg-end justify-content-center gap-2">
                                <a asp-controller="MyHomePage" asp-action="EditQuote" asp-route-id="@quote.QuoteId" class="btn btn-sm btn-outline-dark">Edit</a>
                                <form method="post" asp-controller="MyHomePage" asp-action="DeleteQuote" asp-route-id="@quote.QuoteId" id="delete-quote-form">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info max-width-550 mx-auto mt-4" role="alert">
            You do not have any quotes yet. Add your first private quote to show it on your home page.
        </div>
    }

    <div class="max-width-250 mx-auto mt-3">
        <div class="mb-3">
            <a asp-controller="MyHomePage" asp-action="CreateQuote" class="btn w-100">Add New Quote</a>
        </div>
        <div>
            <a asp-controller="MyHomePage" asp-action="Index" class="btn btn-outline-dark w-100">Back To Home Page</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
    <script type="text/javascript">
       
        $("#delete-quote-form").validate({
            submitHandler: function (form) {
                //ask to confirm delete
                toastConfirm().then(deleteConfirm => {
                    if (deleteConfirm == true) {
                        form.submit();
                    }
                    else {
                        toastr.success("Quote has NOT been deleted");
                    }
                });
            }
        });
    </script>
}
